# Banco de dados MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql_aqui
DB_NAME=estudio

# Segredo usado para assinar a sessao do usuario logado
APP_SECRET=troque_por_uma_string_longa_e_aleatoria

# API propria do projeto (lembretes + relatorios)
API_PORT=3333
API_BASE_URL=http://localhost:3333

# APIs externas consumidas pelo sistema
VIACEP_BASE_URL=https://viacep.com.br/ws
CAMBIO_BASE_URL=https://economia.awesomeapi.com.br/json/last

# Alerta de variacao do dolar (em %) a partir do qual o sistema avisa o dono
COTACAO_ALERTA_PERCENTUAL=2.5

# Envio de e-mail dos lembretes (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Estudio Manager <nao-responda@estudio.local>"
